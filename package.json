{
  "name": "@10coding/apply-to-css-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace for @10coding/apply-to-css",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @10coding/apply-to-css build",
    "dev": "pnpm --filter @10coding/apply-to-css dev",
    "apply-to-css": "node packages/apply-to-css/dist/bin.js",
    "test": "pnpm --filter @10coding/apply-to-css test",
    "test:watch": "pnpm --filter @10coding/apply-to-css test:watch",
    "typecheck": "pnpm --filter @10coding/apply-to-css typecheck",
    "playground": "pnpm --filter @10coding/apply-to-css-playground dev",
    "playground:build": "pnpm --filter @10coding/apply-to-css-playground build",
    "playground:check": "pnpm --filter @10coding/apply-to-css-playground demo:check",
    "playground:diff": "pnpm --filter @10coding/apply-to-css-playground demo:diff",
    "playground:convert": "pnpm --filter @10coding/apply-to-css-playground demo:convert",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
